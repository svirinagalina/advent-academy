POSTGRES_DB=advent_academy
POSTGRES_USER=advent_user
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-32-char-or-longer-secret
CAMUNDA_VERSION=8.7.35
ELASTIC_VERSION=8.17.10

# Frontend session; generate with openssl rand -base64 32 and set in .env.
SESSION_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:3000

# Browser-accessible gateway WebSocket URL (wss:// for HTTPS).
MEETING_SIGNALING_URL=ws://localhost:8090/ws/meetings
MEETING_ALLOWED_ORIGINS=http://localhost:8084,http://127.0.0.1:8084,http://localhost:3000
